@echo off
chcp 65001 >nul 2>&1
setlocal
title BATLAB - RobloxLauncher
echo ============================================
echo  BATLAB - RobloxLauncher
echo ============================================
echo Abrindo o Roblox...
start "" "roblox://"
echo Se o Roblox estiver instalado, ele vai abrir.
echo.
pause
